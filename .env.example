# Copy to .env and fill in. Never commit .env.

# The only phone number allowed to trigger actions via SMS reply.
OWNER_PHONE=+15125550000

# Used only when placing the doctor's-office call (M2) — never stored in the Google Sheet.
PATIENT_NAME=Jane Doe
PATIENT_DOB=1990-01-01

PHARMACY_NAME=Main Street Pharmacy
PHARMACY_PHONE=+15125559999
PHARMACY_ADDRESS=123 Main St, Austin, TX

# Telnyx Mission Control (telnyx.com/mission-control) — API Keys page for TELNYX_API_KEY,
# the messaging profile's Public Key page for TELNYX_PUBLIC_KEY (verifies inbound webhooks;
# this is a separate credential from the API key), and Numbers for the number you provisioned.
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_FROM_NUMBER=+15125550001

# M2 only (voice). Call Control Application ID from Mission Control > Voice > Applications.
TELNYX_CONNECTION_ID=

# M2 only (voice). A locally-generated secret (not from Telnyx) that signs the one-time token
# in the /voice/relay wss:// URL: python -c "import secrets; print(secrets.token_hex(32))"
RELAY_SIGNING_SECRET=

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Path to a Google service account JSON key with access to Sheets API.
# Share the Sheet itself with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
GOOGLE_SHEET_ID=

TIMEZONE=America/Chicago
NUDGE_HOUR_LOCAL=9

DB_PATH=automaterx.db
MAX_CALLS_PER_DAY=5
